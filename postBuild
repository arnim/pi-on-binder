#!/bin/bash
set -euo pipefail

echo "============================================"
echo " postBuild – installing pi-coding-agent"
echo "============================================"

# --- Install pi-coding-agent globally ---
npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# IRkernel is already registered by repo2docker during the conda build step.

# --- Create shell wrapper for workspace auto-start ---
cat > /usr/local/bin/pi-shell-wrapper << 'WRAPPER'
#!/bin/bash
# Auto-start pi if the workspace marker exists,
# otherwise start a normal bash shell.
if [ -f /tmp/.pi-workspace-start ]; then
    rm -f /tmp/.pi-workspace-start
    exec pi --model openrouter/deepseek/deepseek-v4-pro --approve
fi
exec /bin/bash
WRAPPER
chmod +x /usr/local/bin/pi-shell-wrapper

# --- Marker: first terminal in workspace will auto-start pi ---
touch /tmp/.pi-workspace-start

# --- Preload workspace with terminal + notebook split layout ---
jupyter lab workspaces import --name default workspace.jupyterlab-workspace

echo ""
echo "============================================"
echo " Setup complete!"
echo "  - Python 3.11  (scientific stack)"
echo "  - R 4.4        (tidyverse, caret, ...)"
echo "  - pi-coding-agent"
echo "  - workspace: terminal + index.ipynb"
echo "============================================"
